# ── ShopLens AI (optional; install with pip install 'vnecom[ai]') ───────
VNECOM_AI_ENABLED=false
VNECOM_AI_PROVIDER=openai-compatible
VNECOM_AI_BASE_URL=https://api.openai.com/v1
VNECOM_AI_API_KEY=
VNECOM_AI_MODEL=gpt-4o-mini
VNECOM_AI_TIMEOUT_S=60
# ShopLens runtime (AI=1 requires TIER=standard|full)
VNECOM_AI_DATABASE=shoplens
VNECOM_AI_DATABASE_URL=postgresql://vnecom:replace-with-a-strong-postgres-password@postgres:5432/shoplens
VNECOM_AI_DYNAMODB_ENDPOINT_URL=http://dynamodb-local:8000
VNECOM_AI_DYNAMODB_PORT=8001
VNECOM_AI_LANGFUSE_ENABLED=false
VNECOM_AI_LANGFUSE_PUBLIC_KEY=
VNECOM_AI_LANGFUSE_SECRET_KEY=
VNECOM_AI_LANGFUSE_HOST=http://localhost:3001
VNECOM_AI_LANGFUSE_PORT=3001
VNECOM_AI_LANGFUSE_NEXTAUTH_SECRET=replace-with-random-secret
VNECOM_AI_LANGFUSE_SALT=replace-with-random-salt

# ── Deploy tier: lite | standard | full ────────────────────────────────
VNECOM_TIER=lite

# ── Lake ────────────────────────────────────────────────────────────────
# lite: local path. standard/full: s3a://vnecom-lake (MinIO)
VNECOM_LAKE_URI=./lake
# delta (ACID, time travel; needs Delta jars — auto-fetched from Maven in containers)
# parquet (no extra jars; partition-overwrite semantics) — handy for offline/CI
VNECOM_TABLE_FORMAT=delta
VNECOM_TIMEZONE=Asia/Ho_Chi_Minh

# ── Sources (comma-separated). synthetic needs no credentials. ──────────
# synthetic | shopee_open lazada_open tiktok_open | shopee_affiliate accesstrade |
# tiki_public lazada_public sendo_public retail_jsonld | feed
# e.g. market-wide, no paid feed:  VNECOM_SOURCES=shopee_affiliate,accesstrade,tiki_public,lazada_public,sendo_public,retail_jsonld
VNECOM_SOURCES=synthetic

# ── HTTP behaviour (your call) ──────────────────────────────────────────
VNECOM_HTTP_USER_AGENT=vnecom-tracker/0.1 (+mailto:you@example.com)
# requests/sec per connector (0 = no client-side throttle)
VNECOM_HTTP_RPS=0.5
# false = don't consult robots.txt for public sources
VNECOM_RESPECT_ROBOTS=true
# pages per keyword for search-style sources
VNECOM_PUBLIC_MAX_PAGES=5

# Shopee Affiliate Open API — market-wide Shopee offers — https://affiliate.shopee.vn
SHOPEE_AFFILIATE_APP_ID=
SHOPEE_AFFILIATE_SECRET=
SHOPEE_AFFILIATE_KEYWORDS=điện thoại,laptop,tai nghe,nồi chiên không dầu,kem chống nắng,sữa rửa mặt,tã,sữa bột

# AccessTrade VN datafeeds — Shopee/Lazada/Tiki/retailer product feeds — https://pub.accesstrade.vn
ACCESSTRADE_TOKEN=
ACCESSTRADE_DOMAINS=shopee.vn,lazada.vn,tiki.vn

# Public web sources
TIKI_CATEGORY_IDS=1789,1815,8322
LAZADA_PUBLIC_KEYWORDS=điện thoại,laptop,tai nghe bluetooth,nồi chiên không dầu,kem chống nắng
SENDO_PUBLIC_KEYWORDS=áo thun,giày thể thao,nồi cơm điện,ốp lưng
# Retailers via schema.org JSON-LD (config/retailers.yaml)
RETAIL_RETAILERS=thegioididong,dienmayxanh,bachhoaxanh,fptshop,cellphones,hasaki,fahasa
RETAIL_MAX_PRODUCTS=300

# Shopee Open Platform (own shop data) — https://open.shopee.com
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_SHOP_ID=
SHOPEE_ACCESS_TOKEN=

# Lazada Open Platform (own shop data) — https://open.lazada.com
LAZADA_APP_KEY=
LAZADA_APP_SECRET=
LAZADA_ACCESS_TOKEN=

# TikTok Shop Partner Center — https://partner.tiktokshop.com
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_SHOP_CIPHER=

# Licensed market-data feed (CSV/JSONL dropped into lake/landing/feed/)
FEED_VENDOR=

# ── Object storage (standard/full) ──────────────────────────────────────
MINIO_ROOT_USER=vnecom
MINIO_ROOT_PASSWORD=replace-with-a-strong-minio-password
AWS_ACCESS_KEY_ID=vnecom
AWS_SECRET_ACCESS_KEY=replace-with-a-strong-minio-password
AWS_ENDPOINT_URL=http://minio:9000
AWS_REGION=us-east-1

# ── Metadata DB (standard/full) ─────────────────────────────────────────
POSTGRES_USER=vnecom
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password
POSTGRES_DB=vnecom

# ── Spark ───────────────────────────────────────────────────────────────
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=2g

# ── Airflow (standard/full) ─────────────────────────────────────────────
# Generate with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
AIRFLOW_FERNET_KEY=replace-with-a-generated-fernet-key
AIRFLOW_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# ── Superset (full) ─────────────────────────────────────────────────────
SUPERSET_SECRET_KEY=replace-with-a-random-secret-key
SUPERSET_ADMIN_PASSWORD=replace-with-a-strong-superset-password
