{
  "name": "shoplens-clients",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/gateway",
    "packages/contracts"
  ],
  "scripts": {
    "build": "npm run build -w @shoplens/contracts && npm run build -w @shoplens/gateway && npm run build -w @shoplens/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev": "concurrently -n gateway,web 'npm run dev -w @shoplens/gateway' 'npm run dev -w @shoplens/web'",
    "predev": "npm run build -w @shoplens/contracts",
    "format": "prettier --write \"apps/{web,gateway}/**/*.{ts,tsx,css,json}\" \"packages/**/*.ts\" package.json",
    "test:clients": ".venv/bin/python scripts/test-clients.py"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "xcode": "^4.0.0"
  }
}
